# Copier ce fichier en .env.local pour le développement,
# et créer les mêmes variables sur Vercel pour la production.
#
# Sans ces variables, le formulaire de devis refuse l'envoi et affiche
# un message invitant à téléphoner — il ne fait jamais semblant d'avoir envoyé.

# ── Destinataire ────────────────────────────────────────────────────────────
# Où arrivent les demandes de devis. Le Reply-To du message porte l'adresse
# saisie par le visiteur : répondre depuis cette boîte écrit donc au client.
CONTACT_TO=info@lazotoiture.be

# Copie cachée — RECETTE UNIQUEMENT.
# Permet de contrôler ce qui part réellement pendant la mise au point.
# ⚠️ À supprimer une fois la recette terminée : laisser une adresse en copie
# cachée sur des demandes de devis, c'est capter des données de prospects
# (nom, téléphone, adresse du chantier) sans que personne le sache.
# Vide ou absente = aucune copie.
CONTACT_BCC=

# ── Transport 1 (prioritaire) : SMTP ────────────────────────────────────────
# Compte d'envoi partagé avec le CMS Mandala Group (Google Workspace).
# SMTP_PASS est un mot de passe d'application Google, pas le mot de passe du
# compte. Valeurs réelles déjà en place sur Vercel ; l'original vit dans
# /var/www/cms.mandalagroup.com/.env.local du VPS (ssh mandalagroup-cms).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vvazquez@mandalagroup.com
SMTP_PASS=
# Facultatif — défaut : "Devis Lazo Toiture <SMTP_USER>".
# Gmail impose que l'adresse du From soit celle du compte authentifié (ou un
# alias « envoyer en tant que » vérifié) : seul le nom affiché est libre.
SMTP_FROM="Devis Lazo Toiture <vvazquez@mandalagroup.com>"

# ── Transport 2 (repli) : Resend ────────────────────────────────────────────
# Volontairement NON configuré. Le compte Resend de Mandala expédie depuis
# onboarding@resend.dev, le domaine bac à sable de Resend : il ne délivre
# qu'à l'adresse du titulaire du compte et n'atteindrait donc jamais
# info@lazotoiture.be. Un repli silencieusement inopérant est pire que pas
# de repli — en l'état, une panne SMTP renvoie une vraie erreur au visiteur
# et la demande est tracée dans les logs Vercel.
#
# Pour l'activer un jour : vérifier lazotoiture.be dans Resend (SPF + DKIM),
# puis renseigner les deux variables ci-dessous.
RESEND_API_KEY=
CONTACT_FROM=devis@lazotoiture.be
